<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-tell-ai.trends</string>

  <key>Comment</key>
  <string>每天 08:00 用 Cursor CLI 生成 trends 当日 AI 趋势日报</string>

  <key>ProgramArguments</key>
  <array>
    <string>@APP_SUPPORT@/launchd-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@APP_SUPPORT@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>@REPO_ROOT@/trends/.logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@REPO_ROOT@/trends/.logs/launchd-stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
